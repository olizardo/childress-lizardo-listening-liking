#' @title Monochrome Academic Journal Theme for gt
#' @description Applies a clean, minimal black-and-white layout consistent with standard journal guidelines.
apply_journal_theme <- function(gt_tbl) {
  gt_tbl %>%
    tab_options(
      table.font.names = c("Times New Roman", "DejaVu Serif", "Charter", "serif"),
      table.font.size = px(13),
      heading.align = "left",
      heading.title.font.size = px(14),
      heading.title.font.weight = "bold",
      heading.subtitle.font.size = px(12),
      column_labels.font.weight = "bold",
      column_labels.border.top.style = "solid",
      column_labels.border.top.width = px(1.5),
      column_labels.border.top.color = "#000000",
      column_labels.border.bottom.style = "solid",
      column_labels.border.bottom.width = px(1),
      column_labels.border.bottom.color = "#000000",
      table_body.border.bottom.style = "solid",
      table_body.border.bottom.width = px(1.5),
      table_body.border.bottom.color = "#000000",
      table_body.hlines.style = "none",
      table.border.top.style = "none",
      table.border.bottom.style = "none",
      row.striping.include_table_body = FALSE,
      footnotes.font.size = px(11),
      footnotes.border.bottom.style = "none",
      source_notes.font.size = px(11)
    )
}
